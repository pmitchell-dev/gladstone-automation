FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install runtime dependencies
RUN pip install --no-cache-dir flask flask-cors requests gunicorn

# Copy server code
COPY chef/cookbooks/gladstone_base/files/default/scripts/gemini_api_server.py .

EXPOSE 5050

CMD ["gunicorn", "--bind", "0.0.0.0:5050", "--workers", "2", "--timeout", "120", "gemini_api_server:app"]
