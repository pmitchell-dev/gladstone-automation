db:
  url: postgres://kemal:kemal@db:5432/invidious

# General settings
check_tables: true
https_only: false
domain: localhost
port: 3000

# Secrets (Auto-generated by install.sh)
hmac_key: "${HMAC_KEY}"

# Automated Token Management (Replenishes po_token automatically)
invidious_companion:
  private_url: http://invidious-companion:8282
  public_url: http://invidious-companion:8282
  invidious_companion_key: "${COMPANION_KEY}"


# Performance & UI
statistics_enabled: true
external_port: 3000
default_user_static_instance: ""
iv_japanese_font: false

# Privacy
decrypt_captions: true
capture_stats: false
