db:
  url: postgres://kemal:kemal@db:5432/invidious

# General settings
check_tables: true
https_only: false
domain: localhost
port: 3000

# Secrets (HMAC_KEY will be auto-generated by install.sh)
hmac_key: "${HMAC_KEY}"

# YouTube Auth (MUST be filled by user for stable playback)
po_token: "PLACEHOLDER_PO_TOKEN"
visitor_data: "PLACEHOLDER_VISITOR_DATA"

# Performance & UI
statistics_enabled: true
external_port: 3000
default_user_static_instance: ""
iv_japanese_font: false

# Privacy
decrypt_captions: true
capture_stats: false
